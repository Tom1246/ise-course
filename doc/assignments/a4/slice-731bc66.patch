new file mode 100644
index 0000000..4212da8
--- /dev/null
+++ b/lib/priority-mapping.ts
@@ -0,0 +1,66 @@
+/**
+ * A4 slice — mapping the planner's raw course rows onto the slice's capacity input.
+ *
+ * Why this is a separate, tested function: A3 and the A4 peer review established three facts about this
+ * data that a naive mapping gets wrong.
+ *   1. `capacity` and `selected` are present in public/data/courses.json but the application never reads
+ *      them (A3 architecture map §6, risk register R3).
+ *   2. `capacity === 0` is a "not set" sentinel, not "no places": 99 of 2,077 rows carry it (A2 finding,
+ *      confirmed on this file).
+ *   3. `selected` is 0 in 1,968 of the 1,978 rows that have a positive capacity (peer review, 2026-10-05),
+ *      and nothing in the file says **when** those figures were captured. Publishing
+ *      `capacity - selected` as "places left" would therefore dress a static section size up as live
+ *      registration pressure. It is only publishable when the caller can also supply a capture time —
+ *      which is exactly what A1 concluded after being burned by its own stale snapshot
+ *      (A1 brief :181).
+ */
+import type { Capacity, PlanCourse } from './priority.ts';
+
+export interface RawCourseRow {
+  code?: string;
+  name?: string;
+  credit?: number;
+  /** section limit from the data file; 0 means "not recorded" here */
+  capacity?: number;
+  /** enrolled count from the data file — unusable without `enrolmentAsOf` */
+  selected?: number;
+  /** capture time of the enrolment figure; absent in the shipped data */
+  enrolmentAsOf?: string;
+  required?: boolean;
+  autumnOnly?: boolean;
+  clashes?: boolean;
+}
+
+/**
+ * Decide whether this row supports a *dated* enrolment statement.
+ * Returns `unknown` with the reason, rather than a number the data cannot back.
+ */
+export function capacityFromRow(row: RawCourseRow): Capacity {
+  const limit = row.capacity;
+  const enrolled = row.selected;
+  const asOf = row.enrolmentAsOf;
+
+  if (typeof limit !== 'number' || !Number.isFinite(limit) || limit <= 0) {
+    return { kind: 'unknown', why: 'no-capacity-data' };      // includes the 0 sentinel and corrupt values
+  }
+  if (typeof enrolled !== 'number' || !Number.isFinite(enrolled) || enrolled < 0) {
+    return { kind: 'unknown', why: 'no-enrolment-provenance' };
+  }
+  if (typeof asOf !== 'string' || asOf.trim() === '') {
+    return { kind: 'unknown', why: 'no-enrolment-provenance' };
+  }
+  return { kind: 'known', limit, enrolled, asOf };
+}
+
+/** Build the slice's input from whatever the page holds for the plan. */
+export function planCoursesFromRows(rows: RawCourseRow[]): PlanCourse[] {
+  return rows.map((row) => ({
+    code: row.code ?? '',
+    name: row.name ?? '',
+    credit: typeof row.credit === 'number' ? row.credit : 0,
+    capacity: capacityFromRow(row),
+    required: row.required === true,
+    autumnOnly: row.autumnOnly === true,
+    clashes: row.clashes === true,
+  }));
+}
